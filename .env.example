# Copy to .env.local and fill in. Never commit the real file.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=HIVE-WORKSPACE <hello@hive-workspace.com>
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Optional: Google sign-in appears once both are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
